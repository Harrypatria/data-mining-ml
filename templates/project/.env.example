# Copy to .env and fill in. Never commit .env. Secrets stay on the server side of nginx.
APP_ENV=production
CORS_ORIGINS=http://localhost:8080
# Optional shared key between nginx and the API; nginx adds it to proxied requests, the browser never sees it.
API_KEY=
RATE_LIMIT_PER_MINUTE=120
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=400
