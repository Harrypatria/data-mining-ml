# Copy to .env for local runs. Never commit .env. Keys stay on the server; the browser never sees them.
MODEL_DIR=../models
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
API_KEY=
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536
# Explainer: none, openai or anthropic. With none, answers use the deterministic template.
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=400
LLM_MAX_RETRIES=2
LLM_SESSION_LIMIT_PER_HOUR=30
